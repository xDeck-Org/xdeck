{
  "name": "@xdeck/runtime-api",
  "version": "0.3.0",
  "description": "§9.50 — capability catalogue + typed `xdeck` runtime global + AST static analyzer. Pure types + closed-set enum + (subpath `./static-analyzer`) pure-Node walker shared by the install-time validator (apps/backend) and the tag-time CI gate (scripts/ci/).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./static-analyzer": {
      "types": "./dist/static-analyzer.d.ts",
      "default": "./dist/static-analyzer.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./capability": {
      "types": "./dist/capability.d.ts",
      "default": "./dist/capability.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest --passWithNoTests"
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$"
  },
  "license": "UNLICENSED",
  "private": true
}
